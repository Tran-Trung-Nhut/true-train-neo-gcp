# ── Firebase Web config (public identifiers, NOT secrets) ─────────────
# These ship to the browser by design. Access is controlled by Firestore
# rules and the Console's authorized-domains allowlist, never by secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase Admin (server) ───────────────────────────────────────────
# Credentials come from Application Default Credentials only.
#   Local:      gcloud auth application-default login
#   Cloud Run:  the runtime service account, injected automatically
# Never add a service-account JSON path or key material here.
# Set only if ADC cannot infer the project (rare):
# FIREBASE_PROJECT_ID=YOUR-PROJECT

# ── Gemini (SERVER ONLY — never prefix with NEXT_PUBLIC_) ─────────────
# In production the key is read from Google Cloud Secret Manager using the
# Cloud Run runtime service account. Nothing needs to be set here.
#
# Secret name to read (defaults to GEMINI_API_KEY):
# GEMINI_SECRET_NAME=GEMINI_API_KEY
#
# LOCAL DEVELOPMENT ONLY — a direct key that bypasses Secret Manager.
# Leave empty in every deployed environment.
# GEMINI_API_KEY=
